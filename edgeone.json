{
  "name": "djangodemo",
  "outputDirectory": "./output",
  "installCommand": "pip install -r requirements-build.txt",
  "buildCommand": "python build_static.py",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.+\\.json)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
